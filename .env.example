# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Source database for the one-off migration script (scripts/migrate-data.js).
# Only needed if you run `npm run migrate`.
SOURCE_DATABASE_URL=postgresql://user:password@source-host/database?sslmode=require

# HTTP Basic Authentication Credentials
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=streamdesk_password_here
